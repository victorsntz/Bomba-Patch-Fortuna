diff --git a/host/web.cpp b/host/web.cpp
index cd8bb9e..b826506 100644
--- a/host/web.cpp
+++ b/host/web.cpp
@@ -329,6 +329,25 @@ extern "C" EMSCRIPTEN_KEEPALIVE void ps2web_pressure(int a, int b, int c, int d)
 
 extern "C" EMSCRIPTEN_KEEPALIVE int ps2web_rumble() { return ps2::pad_rumble(); }
 
+// port 0 is player 1 and port 1 is player 2; the page plugs the second controller in when a second gamepad shows up
+extern "C" EMSCRIPTEN_KEEPALIVE void ps2web_pad_at(int port, int buttons, int lx, int ly, int rx, int ry) {
+    ps2::set_pad_buttons(port, static_cast<std::uint16_t>(buttons));
+    ps2::set_pad_axis(port, 0, static_cast<std::uint8_t>(rx));
+    ps2::set_pad_axis(port, 1, static_cast<std::uint8_t>(ry));
+    ps2::set_pad_axis(port, 2, static_cast<std::uint8_t>(lx));
+    ps2::set_pad_axis(port, 3, static_cast<std::uint8_t>(ly));
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE void ps2web_pressure_at(int port, int a, int b, int c, int d) {
+    const int packed[4] = {a, b, c, d};
+    for (int i = 0; i < 16; ++i)
+        ps2::set_pad_pressure(port, i, static_cast<std::uint8_t>(static_cast<unsigned>(packed[i / 4]) >> (i % 4 * 8)));
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE int ps2web_rumble_at(int port) { return ps2::pad_rumble(port); }
+
+extern "C" EMSCRIPTEN_KEEPALIVE void ps2web_pad_connected(int port, int connected) { ps2::set_pad_connected(port, connected != 0); }
+
 extern "C" EMSCRIPTEN_KEEPALIVE void ps2web_resize(int width, int height) {
     ps2::resize_window(static_cast<std::uint32_t>(width), static_cast<std::uint32_t>(height));
 }
