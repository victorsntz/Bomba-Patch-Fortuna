diff --git a/scripts/disc.py b/scripts/disc.py
index 474ecef..1333bfe 100644
--- a/scripts/disc.py
+++ b/scripts/disc.py
@@ -134,9 +134,56 @@ def modules(image, destination):
     print('%d SNR2 modules extracted to %s' % (len(found), destination))
 
 
+def packed_entries(image, sector, size):
+    """Entries of the archives code overlays travel in: AFS, and the Konami package that starts with 0x600."""
+    head = read_at(image, sector, 0, 0x30)
+    if len(head) < 0x30:
+        return []
+    if head[:4] == b'AFS\0':
+        count = struct.unpack_from('<I', head, 4)[0]
+        if not 0 < count < 0x10000:
+            return []
+        table = read_at(image, sector, 8, count * 8)
+        return [struct.unpack_from('<II', table, i * 8) for i in range(count)]
+    if struct.unpack_from('<I', head, 0)[0] == 0x600:
+        count = struct.unpack_from('<I', head, 0x20)[0]
+        if not 0 < count < 0x1000:
+            return []
+        offsets = struct.unpack_from('<%dI' % count, read_at(image, sector, 0x28, count * 4))
+        starts = [o + 0x20 for o in offsets]
+        ends = starts[1:] + [size]
+        return [(s, e - s) for s, e in zip(starts, ends) if 0 < s < e <= size]
+    return []
+
+
+def overlays(image, destination):
+    """Code overlays in the Metrowerks MWo3 layout (Konami's Winning Eleven / PES), by the name in their header."""
+    found = {}
+    for path, _, sector, size in image.files():
+        candidates = [(0, size)] if read_at(image, sector, 0, 4) == b'MWo3' else packed_entries(image, sector, size)
+        for offset, length in candidates:
+            if offset + 0x40 > size or read_at(image, sector, offset, 4) != b'MWo3':
+                continue
+            header = read_at(image, sector, offset, 0x40)
+            load, text, data, end = struct.unpack_from('<IIII', header, 8)[0], struct.unpack_from('<I', header, 12)[0], \
+                struct.unpack_from('<I', header, 16)[0], struct.unpack_from('<I', header, 0x18)[0]
+            if end - load != 0x40 + text + data or end - load > length:
+                continue
+            name = header[0x20:0x40].split(b'\0')[0].decode('ascii', 'replace') or 'overlay'
+            body = read_at(image, sector, offset, end - load)
+            if found.get(name, body) != body:
+                name = '%s_%s' % (path.replace('/', '_'), name)
+            found[name] = body
+    os.makedirs(destination, exist_ok=True)
+    for name, body in found.items():
+        with open(os.path.join(destination, name), 'wb') as out:
+            out.write(body)
+    print('%d MWo3 overlays extracted to %s' % (len(found), destination))
+
+
 def main():
     parser = argparse.ArgumentParser(description='Read files from PS2 CD and DVD images, including both layers of a DVD9.')
-    parser.add_argument('command', choices=['info', 'list', 'extract', 'modules'])
+    parser.add_argument('command', choices=['info', 'list', 'extract', 'modules', 'overlays'])
     parser.add_argument('image')
     parser.add_argument('destination', nargs='?')
     parser.add_argument('patterns', nargs='*', help='paths or globs to extract, everything below --limit if omitted')
@@ -151,6 +198,10 @@ def main():
         if not args.destination:
             parser.error('modules needs a destination folder')
