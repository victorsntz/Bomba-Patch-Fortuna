diff --git a/recomp/mwo3.cpp b/recomp/mwo3.cpp
new file mode 100644
index 0000000..0cc1e63
--- /dev/null
+++ b/recomp/mwo3.cpp
@@ -0,0 +1,80 @@
+#include "mwo3.hpp"
+
+#include <cctype>
+#include <cstring>
+
+namespace recomp {
+
+namespace {
+
+std::uint32_t u32(const std::vector<std::uint8_t> &b, std::uint32_t o) {
+    std::uint32_t v = 0;
+    if (o <= b.size() && b.size() - o >= 4) std::memcpy(&v, b.data() + o, 4);
+    return v;
+}
+
+constexpr std::uint32_t kHeader = 0x40;
+
+}
+
+std::optional<Mwo3Overlay> read_mwo3_overlay(std::vector<std::uint8_t> bytes) {
+    if (bytes.size() < kHeader || u32(bytes, 0) != kMwo3Magic) return std::nullopt;
+    Mwo3Overlay o;
+    o.id = u32(bytes, 0x04);
+    o.origin = u32(bytes, 0x08);
+    const std::uint32_t text = u32(bytes, 0x0C), data = u32(bytes, 0x10);
+    const std::uint32_t end = u32(bytes, 0x18);
+    if (o.origin & 3u || text & 3u || end < o.origin || end - o.origin != kHeader + text + data) return std::nullopt;
+    o.size = end - o.origin;
+    if (o.size > bytes.size()) return std::nullopt;
+    o.text_begin = o.origin + kHeader;
+    o.text_end = o.text_begin + text;
+    for (std::uint32_t at = 0x20; at < kHeader && bytes[at]; ++at) o.name += static_cast<char>(bytes[at]);
+    if (const auto dot = o.name.find('.'); dot != std::string::npos) o.name = o.name.substr(0, dot);
+    std::string clean;
+    for (char ch : o.name) clean += std::isalnum(static_cast<unsigned char>(ch)) ? ch : '_';
+    o.name = clean.empty() ? "overlay" : clean;
+    bytes.resize(o.size);
+    o.bytes = std::move(bytes);
+    return o;
+}
+
+std::vector<std::uint32_t> mwo3_call_targets(const Mwo3Overlay &overlay) {
+    std::vector<std::uint32_t> targets;
+    for (std::uint32_t at = overlay.text_begin; at + 4 <= overlay.text_end; at += 4) {
+        const std::uint32_t word = u32(overlay.bytes, at - overlay.origin);
+        if ((word >> 26) == 3u) targets.push_back((at & 0xF0000000u) | ((word & 0x03FFFFFFu) << 2));
+    }
+    return targets;
+}
+
+bool mwo3_opens_frame(const Mwo3Overlay &overlay, std::uint32_t address) {
+    if (address < overlay.text_begin || address + 4 > overlay.text_end || (address & 3u)) return false;
+    const std::uint32_t word = u32(overlay.bytes, address - overlay.origin);
+    return (word >> 16) == 0x27BDu && (word & 0x8000u);
+}
+
+Image mwo3_image(const Mwo3Overlay &overlay) {
+    return Image::raw(overlay.origin, overlay.bytes, {overlay.text_begin, overlay.text_end}, overlay.text_end - overlay.origin);
+}
+
+std::vector<std::uint32_t> mwo3_function_starts(const Mwo3Overlay &overlay) {
+    std::vector<std::uint32_t> starts{overlay.text_begin};
+    for (std::uint32_t at = overlay.text_begin + 8; at + 4 <= overlay.text_end; at += 4) {
+        const std::uint32_t o = at - overlay.origin;
+        const std::uint32_t word = u32(overlay.bytes, o);
+        const bool opens_frame = (word >> 16) == 0x27BDu && (word & 0x8000u);  // addiu sp, sp, -N
+        if (!opens_frame) continue;
+        // Metrowerks pads functions to 16 bytes with zero words after the return
+        std::uint32_t p = o, zeros = 0;
+        while (zeros < 4 && p >= 0x48 && u32(overlay.bytes, p - 4) == 0) {
+            p -= 4;
+            ++zeros;
+        }
+        const bool after_return = p >= 0x48 && u32(overlay.bytes, p - 8) == 0x03E00008u;  // jr ra, then its delay slot
+        if (after_return || zeros >= 2) starts.push_back(at);
+    }
+    return starts;
+}
+
+}
diff --git a/recomp/mwo3.hpp b/recomp/mwo3.hpp
new file mode 100644
index 0000000..c110144
--- /dev/null
+++ b/recomp/mwo3.hpp
@@ -0,0 +1,37 @@
+#pragma once
+
+#include "elf.hpp"
+
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace recomp {
+
+// Code overlay in the Metrowerks "MWo3" layout (Konami's Winning Eleven / PES on PS2, among others).
+// The whole file, header included, is read to a fixed address, so the code is absolute; several
+// overlays can share an address and replace each other at run time.
+//   0x00 'MWo3'  0x04 id  0x08 load address  0x0C text size  0x10 data size  0x14 bss size
+//   0x18 end of text and data in memory  0x1C same  0x20 name, then text at 0x40
+struct Mwo3Overlay {
+    std::string name;
+    std::uint32_t id{};
+    std::uint32_t origin{};
+    std::uint32_t size{};
+    std::uint32_t text_begin{};
+    std::uint32_t text_end{};
+    std::vector<std::uint8_t> bytes;
+};
+
+inline constexpr std::uint32_t kMwo3Magic = 0x336F574Du;
+
+std::optional<Mwo3Overlay> read_mwo3_overlay(std::vector<std::uint8_t> bytes);
+Image mwo3_image(const Mwo3Overlay &overlay);
+// function starts a compiler leaves behind: a stack frame opened right after the previous function returned
+std::vector<std::uint32_t> mwo3_function_starts(const Mwo3Overlay &overlay);
+// targets of every jal in an overlay's text: the functions it calls, in itself, in the program or in other overlays
+std::vector<std::uint32_t> mwo3_call_targets(const Mwo3Overlay &overlay);
+bool mwo3_opens_frame(const Mwo3Overlay &overlay, std::uint32_t address);
+
+}
